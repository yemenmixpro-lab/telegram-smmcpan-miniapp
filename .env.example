* {
  box-sizing: border-box;
}

:root {
  --bg: #0f172a;
  --panel: #111827;
  --panel-soft: #1f2937;
  --primary: #3b82f6;
  --primary-dark: #2563eb;
  --success: #22c55e;
  --error: #ef4444;
  --warning: #f59e0b;
  --text: #e5e7eb;
  --muted: #9ca3af;
  --border: rgba(255, 255, 255, 0.08);
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: linear-gradient(180deg, #020817, #111827);
  color: var(--text);
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

.container {
  max-width: 920px;
  margin: 0 auto;
  padding: 24px 16px 56px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.eyebrow {
  margin: 0;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 12px;
}

h1, h2, h3, p {
  margin-top: 0;
}

.badge {
  background: rgba(59, 130, 246, 0.18);
  color: #dbeafe;
  border: 1px solid rgba(59, 130, 246, 0.3);
  padding: 7px 12px;
  border-radius: 999px;
  font-size: 12px;
}

.message-box,
.filters-panel,
.services-panel,
.order-panel,
.result-box {
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 16px;
  margin-bottom: 16px;
}

.message-box {
  font-size: 14px;
}

.message-box.info {
  border-left: 4px solid var(--warning);
}

.message-box.success {
  border-left: 4px solid var(--success);
}

.message-box.error {
  border-left: 4px solid var(--error);
}

.filters-panel label,
.field-group label {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 13px;
}

.filters-panel input,
.field-group input {
  width: 100%;
  background: rgba(15, 23, 42, 1);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 12px;
  padding: 12px 14px;
  outline: none;
}

.chip-list {
  margin-top: 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chip {
  background: rgba(31, 41, 55, 1);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 999px;
  cursor: pointer;
}

.chip.active {
  background: var(--primary);
  border-color: var(--primary-dark);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.service-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
}

.service-card {
  text-align: left;
  width: 100%;
  background: rgba(31, 41, 55, 0.9);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px;
  color: var(--text);
  cursor: pointer;
}

.service-card.selected {
  border-color: var(--primary);
  box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.4);
}

.service-header,
.service-meta {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}

.service-header strong {
  display: block;
  margin-bottom: 4px;
}

.service-header small,
.service-meta {
  color: var(--muted);
  font-size: 12px;
}

.service-price {
  color: #a5f3fc;
  font-weight: bold;
}

.selected-box {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 16px;
}

.selected-box span,
.selected-box small {
  display: block;
  color: var(--muted);
}

.field-group {
  margin-bottom: 12px;
}

.primary-btn,
.secondary-btn {
  width: 100%;
  border: none;
  border-radius: 12px;
  padding: 12px 14px;
  font-weight: 700;
  cursor: pointer;
}

.primary-btn {
  background: var(--primary);
  color: white;
}

.secondary-btn {
  background: rgba(34, 197, 94, 0.15);
  border: 1px solid rgba(34, 197, 94, 0.22);
  color: #dcfce7;
}

.hidden {
  display: none;
}

.result-box pre {
  background: rgba(15, 23, 42, 1);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px;
  overflow: auto;
}

.empty-state {
  color: var(--muted);
  padding: 16px;
  border: 1px dashed var(--border);
  border-radius: 12px;
  text-align: center;
}

@media (max-width: 600px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }
}
